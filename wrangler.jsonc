{
  "name": "tw-stock-api",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-10",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SCAN_JOBS",
        "class_name": "ScanJob"
      },
      {
        "name": "TX_DOWNLOAD_JOBS",
        "class_name": "TxDownloadJob"
      },
      {
        "name": "STOCK_FUTURES_BATCH",
        "class_name": "StockFuturesBatch"
      },
      {
        "name": "STOCK_FUTURES_DATA",
        "class_name": "StockFuturesData"
      }
    ]
  },
  "migrations": [
    {
      "tag": "r23-scan-jobs-v1",
      "new_sqlite_classes": [
        "ScanJob"
      ]
    },
    {
      "tag": "r50-tx-download-v1",
      "new_sqlite_classes": [
        "TxDownloadJob"
      ]
    },
    {
      "tag": "r51-stock-futures-5y-v1",
      "new_sqlite_classes": [
        "StockFuturesBatch",
        "StockFuturesData"
      ]
    }
  ],
  "triggers": {
    "crons": [
      "0 6,10,14 * * *"
    ]
  }
}
