{
  "name": "tw-stock-api",
  "main": "src/index.js",
  "compatibility_date": "2026-09-10",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "30 10 * * 1-5"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tw-stock-db",
      "database_id": "PASTE_YOUR_D1_DATABASE_ID_HERE",
      "migrations_dir": "migrations"
    }
  ]
}